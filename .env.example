# Copie para .env (que é ignorado pelo git) e ajuste. Nunca coloque chaves de acesso aqui:
# a credencial vem do profile do AWS CLI (~/.aws/credentials).
# Prefixo TC4_ para não colidir com AWS_REGION/AWS_PROFILE globais do shell.

TC4_AWS_PROFILE=fiap-tech-challenge
TC4_AWS_REGION=us-east-1
# Conta pessoal do curso: o código aborta se a credencial for de qualquer outra conta.
TC4_AWS_ACCOUNT_ID=286958704145

# Provedores: "bedrock" (execução principal) ou "local" (só reprodução, plano B2)
TC4_LLM_PROVIDER=bedrock
TC4_EMB_PROVIDER=bedrock

# Modelos Bedrock. B1 (sem Marketplace): Nova + Titan. Trocar para Haiku/Sonnet/Cohere
# quando estiverem AVAILABLE (ver seção 7.2 do planning).
TC4_LLM_MODEL_ID=us.amazon.nova-lite-v1:0
TC4_LLM_FALLBACK_MODEL_ID=us.amazon.nova-pro-v1:0
TC4_LLM_TIMEOUT_S=20
TC4_JUDGE_MODEL_ID=us.amazon.nova-pro-v1:0
TC4_EMB_MODEL_ID=amazon.titan-embed-text-v2:0
TC4_LLM_TEMPERATURE=0.0

# Opcional: onde ficam os índices (BM25, vetores e cache de embeddings). Padrão: ./index
# TC4_INDEX_DIR=~/Library/Caches/tc4/index
